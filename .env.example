# Copy this file to .env and fill in your local Postgres details.
# Homebrew Postgres uses your Mac username with no password by default.
DATABASE_URL=postgresql+psycopg://localhost:5432/ghana_jobs

# ---------- Auth ----------
# Google OAuth Web client ID(s) from Google Cloud > Google Auth Platform > Clients.
# Comma-separated if you add Android/iOS clients later. The client SECRET is NOT needed here.
GOOGLE_CLIENT_IDS=your-client-id.apps.googleusercontent.com

# Signs our own access tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Frontend origins allowed to call the API from a browser (comma-separated).
CORS_ORIGINS=http://localhost:5173

# Local development ONLY: enables POST /auth/dev-login (sign in as any email, no Google).
# Must be false (or absent) anywhere real users can reach the API.
ENABLE_DEV_LOGIN=false
